# ---------------- Development ----------------
# Keep both true until B/C retrievers and the real LLM are connected.
ALLOW_MOCK_RETRIEVERS=true
LLM_MOCK_MODE=true

# ---------------- Vector Retriever ----------------
# Change these only if B places the implementation somewhere else.
VECTOR_RETRIEVER_MODULE=src.vector.retriever
VECTOR_RETRIEVER_FUNCTION=retrieve_vector

# ---------------- Graph Retriever ----------------
# Change these only if C places the implementation somewhere else.
GRAPH_RETRIEVER_MODULE=src.graph.retriever
GRAPH_RETRIEVER_FUNCTION=retrieve_graph

# ---------------- LLM ----------------
# OpenAI-compatible endpoint.
# Example form: https://your-provider.example/v1
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Stage 2
EMBED_MODEL=BAAI/bge-m3
